# VGES-9-Websites .gitignore

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor & IDE settings
.vscode/
.idea/
*.swp
*.swo

# Temporary & Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node dependencies (if any tools are run)
node_modules/

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local

# Archive files & original template zips
*.zip

# Backups & nested git artifacts
.git_original_backup/
scratch/
